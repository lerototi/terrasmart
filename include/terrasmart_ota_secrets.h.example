#pragma once

// Replace these values before building deployment firmware.
#define TERRASMART_OTA_PASSWORD "replace-with-a-long-unique-password"
#define FDRS_OTA_PASSWORD "replace-with-a-long-unique-password"

// Root CA certificate used to validate the HTTPS firmware host. Keep the PEM
// delimiters/newlines in a C string literal. No insecure TLS fallback is used.
#define TERRASMART_OTA_ROOT_CA "-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n"
