#pragma once

// Copy this file to include/terrasmart_secrets.h and replace the placeholders
// before deployment. The local copy is ignored by Git.

// Wi-Fi network used by the MQTT gateway.
#define WIFI_SSID "your-2.4ghz-network"
#define WIFI_PASS "your-wifi-password"

// MQTT broker credentials used by the MQTT gateway.
#define MQTT_ADDR "192.168.1.10"
#define MQTT_PORT 1883
#define MQTT_AUTH
#define MQTT_USER "mqtt-user"
#define MQTT_PASS "your-mqtt-password"

// Password for the TerraSmart setup access point.
#define FDRS_AP_PASSWORD "change-this-ap-password"

// OTA password used by the FDRS ArduinoOTA service and TerraSmart OTA config.
#define TERRASMART_OTA_PASSWORD "replace-with-a-long-unique-password"
#define FDRS_OTA_PASSWORD TERRASMART_OTA_PASSWORD

// Root CA used to validate the HTTPS firmware host. Keep PEM newlines escaped.
#define TERRASMART_OTA_ROOT_CA "-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n"
